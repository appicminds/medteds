# PostgreSQL connection string.
# Local:    postgres://medteds:medteds@localhost:5432/medteds
# Supabase: Project Settings > Database > Connection string (use the "Session pooler" URI)
DATABASE_URL=postgres://medteds:medteds@localhost:5432/medteds

# Auth: generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails that get admin access when they sign up
ADMIN_EMAILS=admin@medteds.local

# Optional: "Continue with Google" sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: store uploaded images in Supabase Storage instead of the database.
# Create a public bucket named "media" first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
